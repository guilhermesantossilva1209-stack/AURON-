# Copy outside version control. Never put provider secrets in the Android app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Required for session mode. Copy the real owner ID from Auth > Users.
OWNER_USER_ID=YOUR_OWNER_USER_UUID
# Optional no-account mode: run node generate-local-access.mjs privately.
# Keep only its hash here; enter the generated token at runtime in the tablet.
# For local-only mode leave ALL THREE Supabase fields above empty.
LOCAL_ACCESS_TOKEN_SHA256=
AI_PROVIDER=ollama
AI_PROVIDER_URL=http://127.0.0.1:11434
AI_MODEL=YOUR_INSTALLED_OLLAMA_MODEL
AI_PROVIDER_KEY=
PORT=8787
REQUEST_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENCY=4
